# Names only - set these as environment variables (IntelliJ: Run > Edit Configurations > Environment variables).
# Do NOT commit real values.
DB_USERNAME=
DB_PASSWORD=
# dev/qa use jdbc:mysql://localhost:3306/<db> literally in the yml; prod uses DB_URL
DB_URL=
JWT_SECRET=            # >= 32 bytes (HS256 needs a 256-bit key)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
